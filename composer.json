{
    "name": "code-sena/test-manager-library-api",
    "type": "project",
    "description": "Backend de Manager Library en PHP con Laravel (Ficha ADSO 3239188)",
    "keywords": ["laravel", "api", "sdd", "manager-library"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0",
        "illuminate/http": "^11.0",
        "illuminate/routing": "^11.0",
        "illuminate/support": "^11.0",
        "illuminate/validation": "^11.0",
        "laravel/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
